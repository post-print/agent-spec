{
	"name": "agent-spec",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"dev": "bun run lint && bun run typecheck && bun run test:unit",
		"check": "bun run lint && bun run typecheck && bun run test:unit && bun run build",
		"test": "node packages/test/dist/cli.js --suites-dir agent-suites --suite confidence --host cursor --fail-on=behavior",
		"test:confidence": "node packages/test/dist/cli.js --suites-dir agent-suites --suite confidence --host cursor --fail-on=behavior",
		"test:tour": "node packages/test/dist/cli.js --suites-dir agent-suites --suite tour --host cursor --fail-on=behavior",
		"test:reference": "node packages/test/dist/cli.js --suites-dir agent-suites --suite reference --host cursor --fail-on=behavior",
		"test:matrix": "node packages/test/dist/cli.js --suites-dir agent-suites --suite confidence --host all --fail-on=behavior",
		"test:sdk:consumer": "bun run build && node scripts/test-sdk-consumer.mjs",
		"test:sdk:hosts": "bun run build && node scripts/test-sdk-hosts.mjs",
		"test:reliability": "bun run build && bun test packages/test/src/__tests__/experiment-controls.test.ts && node scripts/test-reliability.mjs",
		"test:unit": "bun run --filter '*' test",
		"test:sandbox-safe": "bun run --filter '*' test:sandbox-safe",
		"test:coverage": "bun run --filter '*' test:coverage",
		"test:e2e": "bun run --filter @post-print/agent-test test:e2e",
		"typecheck": "bunx tsc --build",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check . --write",
		"format": "bunx biome format --write .",
		"clean": "bun run --filter '*' clean",
		"validate:changed": "skeleton validate changed",
		"validate:ci": "skeleton validate changed --base origin/main",
		"audit:docs": "skeleton audit docs",
		"audit:skills": "skeleton audit skills",
		"audit:self": "skeleton audit self",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@csark0812/skeleton": "^5.0.0",
		"@types/node": "^26.1.1",
		"simple-git-hooks": "^2.13.0",
		"typescript": "~7.0.2"
	},
	"overrides": {
		"undici": "6.28.0",
		"fast-uri": "4.1.3"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1"
	}
}
