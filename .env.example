# Export these variables into your shell; agent-test does not load this file.
# Agents default to subscription auth. Opt into API billing in the definition:
# openai({auth: {type: "api-key", env: "OPENAI_API_KEY"}})
# cursor({auth: {type: "api-key", env: "CURSOR_API_KEY"}})
# claude({auth: {type: "api-key", env: "ANTHROPIC_API_KEY"}})
# OPENAI_API_KEY=
# CURSOR_API_KEY=
# ANTHROPIC_API_KEY=

# Subscription login: agent-test login (Cursor), codex login, or Claude Code login.
# Optional native binary locations:
# CODEX_BIN=
# CLAUDE_CODE_BIN=

# Prefer explicit model settings on agent definitions. Native fallback overrides:
# CODEX_AGENT_MODEL=
# CLAUDE_AGENT_MODEL=
# CURSOR_AGENT_MODEL=
