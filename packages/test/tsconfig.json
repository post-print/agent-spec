{
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"target": "ES2022",
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "react-jsx",
		"verbatimModuleSyntax": false,
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"references": [
		{
			"path": "../harness"
		}
	],
	"exclude": ["src/**/*.test.ts", "src/__tests__/**"]
}
