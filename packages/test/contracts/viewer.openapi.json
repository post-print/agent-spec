{
	"openapi": "3.1.0",
	"info": { "title": "agent-test viewer API", "version": "1" },
	"paths": {
		"/api/test-catalog": { "get": { "operationId": "getTestCatalog" } },
		"/api/executions": {
			"get": { "operationId": "listExecutions" },
			"post": {
				"operationId": "startExecution",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"oneOf": [
									{
										"type": "object",
										"required": ["testId", "workers"],
										"properties": {
											"testId": { "type": "string" },
											"workers": { "type": "integer", "minimum": 1, "maximum": 32 }
										},
										"additionalProperties": false
									},
									{
										"type": "object",
										"required": ["testIds", "workers"],
										"properties": {
											"testIds": {
												"type": "array",
												"minItems": 1,
												"items": { "type": "string" }
											},
											"workers": { "type": "integer", "minimum": 1, "maximum": 32 }
										},
										"additionalProperties": false
									},
									{
										"type": "object",
										"required": ["all", "workers"],
										"properties": {
											"all": { "const": true },
											"workers": { "type": "integer", "minimum": 1, "maximum": 32 }
										},
										"additionalProperties": false
									}
								]
							}
						}
					}
				}
			}
		},
		"/api/executions/{executionId}": { "get": { "operationId": "getExecution" } },
		"/api/executions/{executionId}/cancel": { "post": { "operationId": "cancelExecution" } }
	}
}
