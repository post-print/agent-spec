{
	"name": "@post-print/agent-test",
	"version": "0.3.4",
	"type": "module",
	"bin": {
		"agent-test": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunx tsc --build",
		"typecheck": "bunx tsc --build",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check . --write",
		"test": "bun test",
		"test:sandbox-safe": "bun test --path-ignore-patterns '**/scenario-seed.test.ts'",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"clean": "rm -rf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {
		"@post-print/agent-harness": "workspace:*",
		"chalk": "6"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"typescript": "~7.0.2"
	},
	"description": "Direct-agent scenario runner and CLI for agent-spec suites",
	"repository": {
		"type": "git",
		"url": "https://github.com/post-print/agent-spec.git",
		"directory": "packages/test"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
