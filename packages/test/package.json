{
	"name": "@post-print/agent-test",
	"version": "2.0.2",
	"type": "module",
	"bin": {
		"agent-test": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunx tsc --build && bun ./scripts/build-viewer.ts",
		"generate:viewer-contracts": "bun ./scripts/generate-viewer-contracts.ts",
		"typecheck": "bunx tsc --build",
		"lint": "bunx biome check .",
		"lint:viewer": "bunx biome check src/viewer --error-on-warnings",
		"lint:fix": "bunx biome check . --write",
		"test": "bun test src",
		"test:sandbox-safe": "bun test src",
		"test:coverage": "bun test src --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:e2e": "playwright test",
		"clean": "rm -rf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {
		"@post-print/agent-harness": "workspace:*",
		"@stylexjs/stylex": "0.19.0",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-router": "1.170.32",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-markdown": "10.1.0",
		"@playwright/test": "^1.63.0",
		"ws": "8.18.3",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/ws": "8.5.14",
		"@stylexjs/unplugin": "0.19.0",
		"@vitejs/plugin-react": "6.1.1",
		"typescript": "~7.0.2",
		"vite": "8.2.2"
	},
	"description": "Playwright-based coding-agent tests, comparisons, explicit judges, and viewer",
	"repository": {
		"type": "git",
		"url": "https://github.com/post-print/agent-spec.git",
		"directory": "packages/test"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
