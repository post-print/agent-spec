{
	"name": "@post-print/agent-harness",
	"version": "0.3.3",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunx tsc --build",
		"typecheck": "bunx tsc --build",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check . --write",
		"test": "bun test",
		"test:sandbox-safe": "bun test --path-ignore-patterns '**/{worktree-judge,harness}.test.ts'",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"clean": "rm -rf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {},
	"peerDependencies": {
		"@cursor/sdk": ">=0.1.0"
	},
	"peerDependenciesMeta": {
		"@cursor/sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cursor/sdk": "^1.0.23",
		"@types/node": "^26.1.1",
		"typescript": "~7.0.2"
	},
	"description": "Host-agnostic agent runtime for direct execution, capture, and judging",
	"repository": {
		"type": "git",
		"url": "https://github.com/post-print/agent-spec.git",
		"directory": "packages/harness"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
